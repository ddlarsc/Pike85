<%@ Page 
    AutoEventWireup="true" 
    CodeFile="~/Klubben/KontaktOs.aspx.cs" 
    CodeFileBaseClass="SkabelonPage" 
    Inherits="Klubben.KontaktOs" 
    Language="C#" 
    MasterPageFile="~/Skabelon/Klubben.master" 
    RuntimeMasterPageFile="~/Skabelon/Klubben.master" 
    Title="Pike 85 Klubben Kontakt os" %>

<asp:Content ID="ContentMainPage" ContentPlaceHolderID="KlubbenBody" runat="Server">
    <table>
        <tr>
            <td class="indhold" style="vertical-align:top">
                <h4 style="text-align:center">Klubben Pike 85 - Kontakt Os</h4>
                <p style="text-align:left">
                    Pike 85 er en lille privat lystfiskeriforening med 18 medlemmer, som har eksisteret
                    siden 1985. Formålet med foreningen kan læses i vedtægterne §1.</p>
                <p style="text-align:left">
                    Hjemmesiden her er tænkt som information til alle med interesse for lystfiskeri,
                    med en blanding af nyheder, lystfiskerhistorier, billeder og links til andre lystfisker
                    sites på WWW.</p>
                <p style="text-align:left">
                    Vi optager kun sjældent nye medlemmer i klubben og man skal anbefales af et allerede
                    eksistende medlem for at blive medlem, læs mere i vedtægterne §2.</p>
                <p style="text-align:left">
                    Pike 85 vil meget gerne høre fra jer der ser denne side, det gælder både nyheder,
                    fangster, ris/ros eller bare en sludder. Derfor - Send endelig E-mail til : <a href="mailto:webmaster@pike85.dk">
                        webmaster@pike85.dk </a></p>
                <p style="text-align:left">
                    Kontakt til de enkelte medlemmer kan foregå via email, klik på medlemslisten&nbsp;i
                    menuen.</p>
            </td>
        </tr>
    </table>
</asp:Content>
