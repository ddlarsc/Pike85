<%@ Master 
    AutoEventWireup="true" 
    CodeFile="Links.master.cs" 
    Inherits="Skabelon.LinksMaster" 
    Language="C#" 
    MasterPageFile="~/Skabelon/Pike85.master" %>

<%@ Register TagPrefix="uc1" TagName="LinksUnderMenu" Src="~/UserControls/UcLinksUnderMenu.ascx" %>

<asp:Content ContentPlaceHolderID="Pike85Body" runat="server">
    <table style="height: 100%; width: 100%; table-layout: inherit">
        <tr>
            <td style="text-align: left; width: 100; height: 100%; vertical-align: top">
                <uc1:LinksUnderMenu ID="UC_LinksUnderMenu" runat="server" />
            </td>
            <td class="indhold" rowspan="2" style="text-align: left; width: 100%; height: 100%; vertical-align: top">
                <asp:ContentPlaceHolder ID="LinksBody" runat="server" />
            </td>
        </tr>
    </table>
</asp:Content>
