<%@ Master 
    AutoEventWireup="true" 
    CodeFile="Medlem.master.cs" 
    Inherits="Skabelon.MedlemMaster" 
    Language="C#" 
    MasterPageFile="~/Skabelon/Pike85.master" %>

<%@ Register TagPrefix="uc1" TagName="MedlemUnderMenu" Src="~/UserControls/UcMedlemUnderMenu.ascx" %>

<asp:Content ContentPlaceHolderID="Pike85Body" ID="MedlemBodyId" runat="server">
    <table>
        <tr>
            <td style="text-align:left; width: 100; height:100%; vertical-align: top">
                <uc1:MedlemUnderMenu id="MedlemMenu" runat="server" />
            </td>
            <td style="padding: 5px; vertical-align:top; width:100%; text-align: center">
                <asp:ContentPlaceHolder ID="MedlemBody" runat="server" />
            </td>
        </tr>
    </table>
</asp:Content>
